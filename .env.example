# Live Gemini is the default. Reference only; .env is not auto-loaded.
# Configure keys in private backend settings, never VITE_ variables.
# GEMINI_API_KEY=replace-with-your-google-ai-studio-key
# GEMINI_MODEL=gemini-3.5-flash-lite
# LAB_DEFAULT_PROVIDER=gemini
# LAB_GEMINI_REQUEST_INTERVAL_SECONDS=7
# GEMINI_INPUT_USD_PER_MILLION=replace-with-your-model-input-rate
# GEMINI_OUTPUT_USD_PER_MILLION=replace-with-your-model-output-rate
# Reference only: .env is not loaded automatically. Credentials are optional.
# Use backend environment variables or ~/.agent-reliability-lab/credentials.json.
# Never prefix credentials with VITE_: that exposes them to the frontend.
# OPENAI_API_KEY=replace-with-private-key
# OPENAI_MODEL=gpt-4.1-mini
# LAB_PROVIDER_TIMEOUT_SECONDS=30
# OPENAI_INPUT_USD_PER_MILLION=replace-with-current-model-input-rate
# OPENAI_OUTPUT_USD_PER_MILLION=replace-with-current-model-output-rate
# NOTION_API_KEY=replace-with-private-token
# NOTION_ROOT_PAGE_IDS=replace-with-selected-test-page-uuid
# LAB_CREDENTIALS_FILE=C:\absolute\private\credentials.json
# LAB_DATA_DIR=C:\absolute\private\history
# LAB_PYTHON=C:\absolute\path\to\python.exe
