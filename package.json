{
  "name": "agent-reliability-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs desktop",
    "dev:web": "node scripts/dev.mjs web",
    "preview:desktop": "node scripts/dev.mjs production",
    "build": "npm run build --workspace apps/desktop",
    "build:desktop": "node scripts/native.mjs build --no-bundle",
    "typecheck": "npm run typecheck --workspace apps/desktop",
    "lint": "npm run lint --workspace apps/desktop",
    "test": "npm run test --workspace apps/desktop",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10"
  }
}
